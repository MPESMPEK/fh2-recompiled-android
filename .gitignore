# generated/
# app*/generated/

# --- Build output -------------------------------------------------------------
out/
build/
android/.gradle/
android/local.properties
android/app/build/
android/app/.cxx/
*.o
*.a
*.log

# --- Signing keys (never committed) -------------------------------------------
*.jks
*.keystore
keystore.properties

# --- Tools --------------------------------------------------------------------
__pycache__/
*.pyc
.vscode/

# --- Third-party sources (vendored for self-contained CI builds) --------------
