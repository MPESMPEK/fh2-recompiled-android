# Nothing derived from the game is ever committed: its files, the code generated from default.xex,
# and the binaries built from that code.

# --- Game files ---------------------------------------------------------------
assets/
game_root/
*.xex
*.xexp
*.iso
*.fxobj
*.fsb
*.nfsp

